.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ============ Database ============
*.db
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
data/shelf.db
data/demo_shelf.db
data/*.db

# ============ Logs ============
*.log
logs/
data/logs/*.log
*.log.*

