*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ============ Virtual Environment ============
venv/
ENV/
env/
.venv/
env.bak/
venv.bak/

